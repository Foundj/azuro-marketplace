{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "azuro-marketplace",
  "description": "Azuro Plugin Marketplace - AI development tools and workflow automation",
  "metadata": {
    "version": "4.1.17"
  },
  "owner": {
    "name": "foundj"
  },
  "plugins": [
    {
      "name": "ai-dev",
      "source": "./",
      "strict": false,
      "description": "Industrial-grade AI development orchestration with 7-phase gated workflow, OODA autonomous completion, knowledge management, and project context awareness",
      "version": "4.1.17",
      "repository": "https://github.com/Foundj/azuro-marketplace",
      "keywords": [
        "ai-development",
        "orchestration",
        "ooda-loop",
        "code-generation",
        "workflow-automation",
        "7-phase-workflow"
      ],
      "skills": [
        "./skills/thinking-engine",
        "./skills/competitor-research",
        "./skills/knowledge-graph",
        "./skills/skill-auditor",
        "./skills/claude-reflect",
        "./skills/context-bridge",
        "./skills/ai-dev"
      ],
      "commands": [
        "./commands/ai:archive.md",
        "./commands/ai:auto.md",
        "./commands/ai:check.md",
        "./commands/ai:design.md",
        "./commands/ai:dev.md",
        "./commands/ai:fix.md",
        "./commands/ai:implement.md",
        "./commands/ai:interview.md",
        "./commands/ai:knowledge.md",
        "./commands/ai:list.md",
        "./commands/ai:loop.md",
        "./commands/ai:quality.md",
        "./commands/ai:research.md",
        "./commands/ai:resume.md",
        "./commands/ai:review.md",
        "./commands/ai:show.md",
        "./commands/ai:skills-audit.md",
        "./commands/ai:skills-audit:one.md",
        "./commands/ai:status.md",
        "./commands/ai:update-constraints.md",
        "./commands/ai:update-feature-index.md",
        "./commands/session:save.md",
        "./commands/session:resume.md"
      ],
      "hooks": "./hooks/hooks.json"
    },
    {
      "name": "self-learning",
      "source": "./skills/claude-reflect",
      "strict": false,
      "description": "Self-learning system that captures corrections during sessions and updates your project conventions",
      "version": "4.1.17",
      "keywords": [
        "learning",
        "reflection",
        "conventions",
        "automation"
      ],
      "skills": [
        "./SKILL.md"
      ],
      "commands": [
        "./commands/reflect.md",
        "./commands/skip-reflect.md",
        "./commands/view-queue.md"
      ]
    },
    {
      "name": "thinking-toolbox",
      "source": "./skills/thinking-engine",
      "strict": false,
      "description": "Advanced reasoning and chain-of-thought engine for complex problem solving",
      "version": "4.1.17",
      "keywords": [
        "thinking",
        "cot",
        "reasoning",
        "logic"
      ],
      "skills": [
        "./SKILL.md"
      ],
      "commands": []
    },
    {
      "name": "context-bridge",
      "source": "./skills/context-bridge",
      "strict": false,
      "description": "Cross-session context management - save progress, restore and auto-continue tasks. Bridges Manus 3-file pattern with Azuro 7-phase workflow",
      "version": "4.1.17",
      "keywords": [
        "context",
        "session",
        "checkpoint",
        "resume",
        "persistence",
        "manus"
      ],
      "skills": [
        "./SKILL.md"
      ],
      "commands": [
        "./commands/checkpoint.md",
        "./commands/resume.md",
        "./commands/focus.md",
        "./commands/lite-save.md",
        "./commands/lite-resume.md"
      ]
    }
  ]
}
