{
  "$schema": "./model-config.schema.json",
  "version": "1.0.0",
  "description": "Model configuration for ai-dev agents with Claude Code and OpenCode compatibility",
  
  "model_profiles": {
    "strategy": {
      "description": "Architecture decisions, debugging, high-level reasoning",
      "primary": "openai/gpt-5.2",
      "fallback": ["anthropic/claude-sonnet-4-5", "anthropic/claude-opus-4-5"],
      "claude_code_alias": "claude-sonnet-4-5-thinking"
    },
    "knowledge": {
      "description": "Documentation lookup, codebase understanding, pattern discovery",
      "primary": "anthropic/claude-sonnet-4-5",
      "fallback": ["google/antigravity-gemini-3-flash", "anthropic/claude-haiku-4-5"],
      "claude_code_alias": "claude-sonnet-4-5"
    },
    "explore": {
      "description": "Fast code exploration, pattern matching, quick searches",
      "primary": "google/antigravity-gemini-3-flash",
      "fallback": ["anthropic/claude-haiku-4-5", "opencode/grok-code"],
      "claude_code_alias": "claude-haiku-4-5"
    },
    "frontend": {
      "description": "UI/UX design, frontend implementation, styling",
      "primary": "google/antigravity-gemini-3-pro-high",
      "fallback": ["anthropic/claude-sonnet-4-5", "anthropic/claude-opus-4-5"],
      "claude_code_alias": "claude-sonnet-4-5"
    },
    "verification": {
      "description": "Quick validation, test execution, build checks",
      "primary": "anthropic/claude-haiku-4-5",
      "fallback": ["google/antigravity-gemini-3-flash"],
      "claude_code_alias": "claude-haiku-4-5"
    }
  },

  "agent_mapping": {
    "oracle": "strategy",
    "librarian": "knowledge",
    "explore-fast": "explore",
    "frontend-engineer": "frontend",
    "verification-agent": "verification",
    "quick-fixer": "explore",
    "code-explorer": "knowledge",
    "debugger": "strategy"
  },

  "environment_detection": {
    "claude_code": {
      "indicators": ["CLAUDE_CODE", ".claude/settings.json"],
      "model_field": "model"
    },
    "opencode": {
      "indicators": ["OPENCODE", "opencode.json", ".opencode/"],
      "model_field": "model_override"
    }
  },

  "model_aliases": {
    "claude-sonnet-4-5": "anthropic/claude-sonnet-4-5",
    "claude-sonnet-4-5-thinking": "anthropic/claude-sonnet-4-5",
    "claude-opus-4-5": "anthropic/claude-opus-4-5",
    "claude-haiku-4-5": "anthropic/claude-haiku-4-5",
    "gpt-5.2": "openai/gpt-5.2",
    "gemini-3-flash": "google/antigravity-gemini-3-flash",
    "gemini-3-pro": "google/antigravity-gemini-3-pro-high"
  }
}
